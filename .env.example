# Copy only the settings you need into .env. Never commit real API keys.
# Setup.command can generate and maintain .env interactively.

# -----------------------------------------------------------------------------
# Level 1: Core local RAG (required)
# -----------------------------------------------------------------------------
FEATURE_LEVEL=core
ZOTERO_DATA_DIR=/absolute/path/to/Zotero
EMB_PROFILE=fast
# CHROMA_DIR=/absolute/path/to/zotero-local-rag/data/chroma
# EMB_MODEL=/absolute/path/to/a/local/sentence-transformers/model
# EMB_DEVICE=cpu
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# -----------------------------------------------------------------------------
# Level 2: Citation Network and bibliographic metadata (internet + S2 key needed)
# -----------------------------------------------------------------------------
# FEATURE_LEVEL=citation
# S2_API_KEY=your-api-key
# Optional Zotero Web API write-back of OpenAlex-resolved DOI values.
# ZOTERO_USER_ID=
# ZOTERO_API_KEY=
# Optional metadata-provider settings.
# CINII_APP_ID=
# CROSSREF_MAILTO=

# -----------------------------------------------------------------------------
# Level 3: LLM-assisted features (optional)
# Query expansion, LLM summaries, PDF/HTML reference extraction, and review automation.
# -----------------------------------------------------------------------------
# FEATURE_LEVEL=llm
# LLM_CHEAP=deepseek:deepseek-v4-flash
# LLM_STANDARD=deepseek:deepseek-v4-pro
# LLM_REVIEW=deepseek:deepseek-v4-pro
# DEEPSEEK_API_KEY=
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high
# Maintenance summary batch uses LLM_CHEAP, then LLM_STANDARD on gate failure.
# SUMMARY_BATCH_MAX_ITEMS=20
# SUMMARY_BATCH_WORKERS=10
# ANTHROPIC_API_KEY=
# LLM_OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_OPENAI_API_KEY=

# Cloud safety is fail-closed unless one policy is explicitly selected.
# Recommended blacklist policy: tagged items are never sent to summary/extraction LLMs.
# SUMMARY_EXCLUDE_TAGS=private,confidential
# EXTRACT_EXCLUDE_TAGS=private,confidential
# Or explicitly allow every item (do not combine with the blacklist policy).
# SUMMARY_ALLOW_CLOUD_ALL=0
# EXTRACT_ALLOW_CLOUD_ALL=0
# You may keep exclusion policy separate from secrets in ignored .env.policy.

# -----------------------------------------------------------------------------
# Optional Japanese re-OCR
# -----------------------------------------------------------------------------
# NDLOCR_BIN=/absolute/path/to/ndlocr-lite
# NDLOCR_DPI=200
# NDLOCR_TIMEOUT_SEC=14400
# Re-OCR remains available as an explicit command: scripts/run_reocr_queue.py.
