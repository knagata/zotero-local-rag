# Copy only the settings you need into .env. Never commit real API keys.
# Setup.command can generate and maintain .env interactively.
# Variables are grouped by feature area; each group notes what it's for and
# whether it's required, optional-with-safe-defaults, or purely opt-in.

# =============================================================================
# 1. Zotero source (required)
# =============================================================================
ZOTERO_DATA_DIR=/absolute/path/to/Zotero
FEATURE_LEVEL=core
EMB_PROFILE=fast
INGEST_STRUCTURED_V3_ENABLE=1
HIERARCHICAL_SEARCH_V2_ENABLE=1
CHROMA_COLLECTION=zotero_paragraphs_v3
MANIFEST_PATH=data/manifest_v3.json
LEXICAL_DB_PATH=data/lexical_v3.sqlite3
# CHROMA_DIR=/absolute/path/to/zotero-local-rag/data/chroma
# EMB_MODEL=/absolute/path/to/a/local/sentence-transformers/model
# EMB_DEVICE=cpu
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# Zotero Local API (better BibTeX). Defaults shown; override only if your
# Zotero listens elsewhere or you use a non-default user profile.
# ZOTERO_LOCAL_API_BASE=http://127.0.0.1:23119/api
# ZOTERO_LOCAL_API_PREFIX=users/0

# =============================================================================
# 2. Citation Network and bibliographic metadata (internet + S2 key needed)
# =============================================================================
# FEATURE_LEVEL=custom
# S2_API_KEY=your-api-key
# Optional Zotero Web API write-back of OpenAlex-resolved DOI values.
# ZOTERO_USER_ID=
# ZOTERO_API_KEY=
# Optional metadata-provider settings.
# CINII_APP_ID=
# CROSSREF_MAILTO=

# =============================================================================
# 3. LLM-assisted features (optional)
# Query expansion, LLM summaries, PDF/HTML reference extraction, and review automation.
# =============================================================================
# FEATURE_LEVEL=custom
# LLM_CHEAP=deepseek:deepseek-v4-flash
# LLM_STANDARD=deepseek:deepseek-v4-pro
# LLM_REVIEW=deepseek:deepseek-v4-pro
# Required whenever any LLM_CHEAP/STANDARD/REVIEW role above uses deepseek:*.
# DEEPSEEK_API_KEY=
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high
# Per-request safeguards for large summary backfills. Defaults retain the
# previous 300s timeout / three attempts; 60s / two attempts is a practical
# operational setting when a provider is intermittently slow.
# SUMMARY_LLM_TIMEOUT_SECONDS=60
# LLM_RETRY_ATTEMPTS=2
# Maintenance summary batch uses LLM_CHEAP, then LLM_STANDARD on gate failure.
# SUMMARY_BATCH_MAX_ITEMS=20
# SUMMARY_BATCH_WORKERS=10
# CASE_BATCH_MAX_ITEMS=10
# CASE_SELECTOR_SAMPLES=2
# CASE_BATCH_WORKERS=10
# CASE_MAX_PER_SECTION=5
# Alternative providers for any LLM_CHEAP/STANDARD/REVIEW role above.
# Required only if that role's provider prefix is anthropic:/gemini:/openai_compat:.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# LLM_OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_OPENAI_API_KEY=

# Per-item cloud exclusion tags were removed on 2026-07-27. Anything in the
# index is returned by rag_search and therefore reaches the assistant, so an
# item-level cloud veto could not hold -- the meaningful decision is whether a
# document belongs in the library at all. The tag lookup was also an HTTP call
# to Zotero that failed closed, so a momentarily unreachable Zotero turned
# every scanned PDF into an unnecessary local re-OCR.
# Cloud use is governed by the feature flags instead: the LLM_* roles above,
# PDF_AI_TOC_FAST_PATH_ENABLE (sends 20 pages) and PDF_MISTRAL_TOC_QUEUE_ENABLE
# (sends whole documents).

# Maintenance-Widget.command's summary step processes a bounded batch of items
# per run (not the whole library), using N concurrent workers (each item is an
# independent unit; LLM calls are I/O-bound so overlapping wait time on the
# DeepSeek API roundtrip gives a substantial speedup). Adjust per your API
# throughput/rate limits. For a one-shot full backfill instead of repeated
# widget runs, use scripts/detached_summary_backfill.py.
# SUMMARY_BACKFILL_BATCH_SIZE=10
# SUMMARY_BACKFILL_WORKERS=10

# Maintenance Widget confirmations. Set to 0 to restore the per-step prompts.
# The default is 1 after the library owner has approved automated maintenance.
MAINTENANCE_AUTO_APPROVE=0

# The legacy collection/manifest/FTS are retired. Production entry points reject
# attempts to select them; use the five V3 values in section 1 unchanged.

# =============================================================================
# 4. Optional PDF-structuring engines (evaluations/ocr_bakeoff_v3/)
# =============================================================================
# --- Local OCR overrides. RapidOCR/NDLOCR are used for fixed-layout EPUBs and
# explicit re-OCR work; ordinary scanned PDFs go directly to Docling (<30 pages,
# or the queue disabled) or the Mistral OCR Batch queue (>=30 pages).
# RAPIDOCR_DPI=200
# RAPIDOCR_MIN_CONFIDENCE=0.45
# NDLOCR_BIN=/absolute/path/to/ndlocr-lite
# NDLOCR_DPI=200
# NDLOCR_TIMEOUT_SEC=14400
# --- YomiToku (local, CC BY-NC-SA 4.0 non-commercial license; personal
# research use only). No key required; installed via `pip install yomitoku`.
# YOMITOKU_DEVICE=cpu
# YOMITOKU_LITE=1
# YOMITOKU_DPI=200
# --- Mistral OCR (cloud fallback for materials local structuring cannot parse
# well; not a routine path). Even with a key configured, the bake-off also
# requires OCR_BAKEOFF_ALLOW_CLOUD=1 before it will run.
# MISTRAL_OCR_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_OCR_BASE_URL=https://api.mistral.ai
# MISTRAL_OCR_TIMEOUT_SEC=120
# OCR_BAKEOFF_ALLOW_CLOUD=0
# Synchronous Mistral OCR remains available only to explicit re-OCR routes.
# Ordinary PDF automation uses the non-canonical Batch queue, so existing
# chunks remain untouched until staged adoption.
# MISTRAL_OCR_BATCH_MAX_INPUT_BYTES=104857600
# MISTRAL_OCR_BATCH_UPLOAD_WORKERS=3

# AI TOC fast path for structured V3 PDF ingestion. When enabled, PDFs with
# clean extracted text but no usable embedded outline send only the first N
# pages of extracted text to LLM_STANDARD, infer TOC-granularity headings, and
# skip Docling only when deterministic full-document heading alignment passes.
# Disabled by default because this is a cloud text send; this flag is the gate.
# PDF_AI_TOC_FAST_PATH_ENABLE=0
# PDF_AI_TOC_MIN_PAGES=30
# Enable the Batch defer route when either size bucket below selects Mistral.
# With this flag off, documents assigned to Mistral fall back to Docling.
# PDF_MISTRAL_TOC_QUEUE_ENABLE=0
# PDF_AI_TOC_SAMPLE_PAGES=20
# When the AI-TOC path accepts a PDF, re-parse only its reference/endnote
# section pages with Docling for one-entry-per-chunk structure (note 77 E2b).
# Opt-in and fail-closed: any Docling error keeps the coarse AI-TOC chunks.
# PDF_AI_TOC_DOCLING_REFERENCES_ENABLE=0
# When a PDF has clean embedded text but some scanned/image-only pages (figure
# plates, a scanned dedication page, etc.), patch just those pages via a
# Docling sub-PDF pass instead of sending the whole document to Mistral OCR
# (note 77 E2c). Gated on is_scanned=false (scanned_ratio<0.8): a genuinely
# scanned document (ratio>=0.8) still escalates to Mistral OCR since local
# patching wouldn't help. No page-count cap -- the per-page "attempted =
# resolved" semantics already prevent garbage/index pollution regardless of
# how many pages that covers (user decision 2026-07-25/07-26). Pages Docling
# attempts but finds no text on get a visible block_type="figure" marker
# chunk rather than being silently dropped.
# PDF_SCANNED_PAGE_PATCH_ENABLE=0
# Same idea for pages with *corrupted* text (font-encoding mismatch or OCR/
# linguistic noise already baked into the extracted text, not image-only) --
# patch just those pages via a Docling sub-PDF pass and replace the garbled
# PyMuPDF chunks (note 77 E2d). The page still renders fine even when its text
# layer is broken (glyph rendering doesn't depend on the broken ToUnicode/CMap
# table), so re-OCRing the rendered page recovers real text. Gated on
# is_corrupted=false (corrupted_ratio<0.6): a genuinely corrupted document
# still escalates to Mistral OCR. Pages Docling can't recover clean text from
# get a block_type="corrupted_unresolved" marker chunk (distinct from the
# scanned-page "figure" marker: an unresolved corrupted page is body text
# that resisted repair, not necessarily a figure).
# PDF_CORRUPTED_PAGE_PATCH_ENABLE=0
# Pages per Docling sub-PDF pass for the two page patches above (default 24).
# A single pass over every wanted page OOM-killed ingestion on a document
# with 208 corrupted pages (AX5CRKJ6, 2026-07-26); bounded batches keep peak
# memory flat (gc + torch cache release between batches), and a failed batch
# leaves visible figure/corrupted_unresolved markers for its pages instead of
# aborting the remaining batches.
# PDF_PAGE_PATCH_BATCH_PAGES=24

# --- Text-layer provenance and OCR-quality auditing (note 79) --------------
# A scanned PDF that has been through OCR also has a text layer, so "has text"
# does not identify the document type; what matters is whether the text layer
# can be trusted. pdf_provenance.classify_pdf_source decides this from whether
# any *pure-text* pages exist: a scan images its front matter too, while a
# born-digital document -- even a plate-heavy art book -- always typesets its
# preface and imprint. Measured over 80 library documents, scans had 0-2
# pure-text pages in a 19-page front-loaded sample and born-digital documents
# 4-18, with no overlap. The old is_scanned flag counted pages *lacking* text
# and so missed all 67 OCRed scans in the library.
#
# Deterministic extraction-defect detectors (stage 1). These are extraction
# artefacts, not OCR problems, so the remedy is re-extraction. Measured:
# Latin-dominant documents sit at 0.6-3.1% isolated single letters, the two
# affected ones at 7.4% and 38.3%. The ratio is only computed for
# Latin-dominant text (>=2000 Latin tokens, >50% Latin characters) because in a
# CJK document the sparse Latin tokens are mostly initials -- two Japanese
# documents measured 38.8% and 84.5% off ~200 tokens.
# PDF_LETTER_SPACING_RATIO_MAX=0.05
# Dropped ft/fi/fl ligatures ("sofware", "afer"). Unlike a *preserved* ligature
# codepoint, which clean_extracted_text's NFKC pass already decomposes, a
# dropped one cannot be recovered by normalisation. Detected via a closed list
# of the words this produces: 226 hits in the one affected document, 0-6
# elsewhere.
# PDF_DROPPED_LIGATURE_RATIO_MAX=0.0005
#
# Stage 2: sample body pages of a scan-derived text layer and have the cheap
# LLM role enumerate OCR misrecognitions. Scan quality is near-constant across
# a document, so a few pages represent the whole. Every reported item is
# verified against the sampled text before it counts -- during calibration 23%
# of reported items did not occur in the source at all, and one document was
# called severely degraded on entirely fabricated evidence. Fail-closed on
# verdicts are cached per source fingerprint so
# reingestion costs no API calls. Set to 0 to skip the audit, in which case a
# scan-derived layer is accepted unmeasured.
# OCR_LAYER_AUDIT_ENABLE=1
# Verified-misrecognition rate at or above which the layer is re-OCRed. Rates
# do not separate scans from born-digital cleanly on their own (healthy control
# documents reached 1.22%), so this is deliberately conservative: only clear
# cases act automatically. An ABBYY-OCRed 567-page book measured 0.25% --
# re-OCRing that would spend cloud budget replacing good text.
# OCR_LAYER_DEGRADED_RATE=0.015
# Rate above which the result is recorded for review but not acted on. This
# middle band is left to the report loop (report_chunk_quality) instead.
# OCR_LAYER_REVIEW_RATE=0.005
#
# Repair pages of a scan-derived document whose OCR produced nothing usable.
# The document-level local-OCR gate is all-or-nothing, so without this a scan
# whose OCR failed on only some pages had to be re-OCRed whole or accepted
# as-is. Unrecovered pages get a corrupted_unresolved marker, never "figure":
# in a scan a text-less page is a failure, not an illustration.
# PDF_SCAN_PAGE_REPAIR_ENABLE=1
# PDF_SCAN_PAGE_REPAIR_MIN_CHARS=80
#
# Retain unusable page text as zone="corrupted" instead of dropping it
# silently. ZONE_POLICIES excludes that zone from ordinary retrieval and from
# summary input, so it cannot pollute either, but it stays reachable through
# rag_search(include_corrupted=True) and answers "why is page 88 missing?".
# Applies to newly ingested material only -- text already discarded is not
# recoverable without a reingest, and no retroactive pass is planned.
# PDF_RETAIN_CORRUPTED_TEXT=1

# Note (P7, note 78, 2026-07-26): PDF_MISTRAL_TOC_QUEUE_ENABLE governs the
# Mistral batch-queue deferral on its own -- it is no longer AND-coupled to
# PDF_AI_TOC_FAST_PATH_ENABLE (the queue is not an AI-TOC subfeature).
# For scanned-PDF OCR replacement the fixed threshold is 30 pages: below it,
# and whenever cloud policy cannot be confirmed, use Docling. The AI-TOC
# structure-recovery route retains its independent policy.

# Text-quality thresholds (P3, note 78, 2026-07-26). The page-level and
# document-level thresholds are separate variables because they are
# different-dimensional quantities -- tuning one must not silently move the
# other (e.g. lowering the document ratio to 0.6 via the old shared variable
# would also have reclassified every 40-79-character page as scanned and
# ballooned the E2c patch workload).
#   Page-level (analyze_text_quality scores):
# TEXT_QUALITY_SCAN_THRESHOLD=0.8
# TEXT_QUALITY_CORRUPTION_THRESHOLD=0.6
#   Document-level (scanned_ratio / corrupted_ratio for is_scanned /
#   is_corrupted). Unset, each inherits the page-level variable above, so
#   existing .env files keep behaving identically. The 0.8-vs-0.6 asymmetry is
#   deliberate, not drift: scanned pages are individually patchable figure
#   plates (a 47%-figure catalog can still have healthy body text), while a
#   text layer that is 60% corrupted already makes the document untrustworthy
#   -- so the whole-document escalation bar is higher for scans.
# TEXT_QUALITY_SCANNED_RATIO_THRESHOLD=0.8
# TEXT_QUALITY_CORRUPTED_RATIO_THRESHOLD=0.6
# Residual-anomaly tolerance shared by the PyMuPDF fast path AND the AI-TOC
# ratio gate (P4, note 78): ratios are post-repair residuals; repair (the
# E2c/E2d patches) is tried first, and this tolerance only applies to what
# repair could not resolve.
# PYMUPDF_NATIVE_OUTLINE_ANOMALY_RATIO_MAX=0.02

# Optional post-embedding GROBID enrichment for English scholarly PDFs.
# GROBID_ENRICHMENT_ENABLE=0
# GROBID_URL=http://127.0.0.1:8070
# GROBID_TIMEOUT_SEC=120
# PDF_AI_TOC_MIN_COVERAGE=0.90
# PDF_AI_TOC_MIN_STRUCTURED_CHUNK_RATIO=0.80

# =============================================================================
# 5. Unused by current code (present for forward compatibility only)
# No source file reads these right now; kept here only if you rely on them
# from outside this repo. Safe to remove from .env if you don't.
# =============================================================================
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=

# =============================================================================
# Feature flags (all default to 0; Setup.command writes what you choose)
# A feature switched on without the resource it needs stops the run with a
# message naming both -- it is never silently skipped.
# =============================================================================
# (A) Recover document structure for PDFs. With this off, PDFs are indexed as
# plain text (local OCR still runs where there is no text layer) and no
# structuring engine is called. EPUB/HTML DOM structuring is unaffected.
# PDF_STRUCTURE_RECOVERY_ENABLE=0
#
# (B) Paid-LLM features. Each needs an LLM_* role configured.
# PDF_AI_TOC_FAST_PATH_ENABLE=0
# OCR_LAYER_AUDIT_ENABLE=0
# QUERY_EXPANSION_ENABLE=0
# LLM_SUMMARIES_ENABLE=0
# LLM_REFERENCE_EXTRACTION_ENABLE=0
#
# Citation Network needs S2_API_KEY. The key is free, but the unkeyed public
# rate limit is too low for the pipeline to make progress.
# CITATION_NETWORK_ENABLE=0
#
# (C) Which engine structures a PDF, chosen per size bucket:
#   docling  free,  fast,   best on tables and formulas
#   granite  free,  ~2.3x slower, more accurate overall; needs its own venv
#            (mlx-vlm and Docling require incompatible transformers versions)
#            and Apple Silicon
#   mistral  paid per page, fast, strongest on long scans; reached through the
#            non-canonical batch queue, so existing chunks are untouched until
#            a staged result is explicitly adopted
# The boundary is its own setting on purpose: PDF_AI_TOC_MIN_PAGES asks whether
# a document is long enough to have a table of contents, this asks which engine
# should carry the cost. The defaults coincide at 30; the questions do not.
# PDF_STRUCTURE_ENGINE_SHORT=docling
# PDF_STRUCTURE_ENGINE_LONG=docling
# PDF_STRUCTURE_ENGINE_PAGE_BOUNDARY=30
# PDF_MISTRAL_TOC_QUEUE_ENABLE=0
# GRANITE_VENV_PYTHON=tmp/granite_docling_venv/bin/python
