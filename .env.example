# Copy only the settings you need into .env. Never commit real API keys.
LLM_DEFAULT=gemini:gemini-3.1-flash-lite
LLM_EXPAND=gemini:gemini-3.1-flash-lite
LLM_SUMMARY=codex_cli:gpt-5.6-luna
LLM_EXTRACT=gemini:gemini-3.1-flash-lite

# Comma-separated Zotero tags that must never be sent to a summary LLM.
# If configured and Zotero tags cannot be checked, LLM summarization fails closed.
# SUMMARY_EXCLUDE_TAGS=private,confidential
# EXTRACT_EXCLUDE_TAGS=private,confidential
# If all items may be sent to the configured provider, opt in explicitly.
# SUMMARY_ALLOW_CLOUD_ALL=0
# EXTRACT_ALLOW_CLOUD_ALL=0
# SUMMARY_EMBED_BATCH_SIZE=16

# You may keep exclusion policy separate from secrets in an ignored .env.policy file.

# CiNii Research OpenSearch v2 requires a registered application ID.
# CINII_APP_ID=

# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high

# Japanese re-OCR (used only by the explicit re-OCR candidate queue)
# NDLOCR_BIN=/absolute/path/to/ndlocr-lite
# NDLOCR_DPI=200
# NDLOCR_TIMEOUT_SEC=14400
# NIGHTLY_REOCR_ENABLE=0
# NIGHTLY_REOCR_CANDIDATES=/absolute/path/to/reocr-candidates.json
# NIGHTLY_REOCR_MAX_ITEMS=2

# Nightly launchd schedule and safety limits (local time; macOS uses the system timezone).
# NIGHTLY_ENABLE=0
# NIGHTLY_START_TIME=03:30
# NIGHTLY_MAX_HOURS=5
# NIGHTLY_MAX_ITEMS=20
# NIGHTLY_MIN_WEEKLY_REMAINING_PERCENT=20

# OpenAI-compatible servers (Ollama, LM Studio, vLLM, or OpenAI itself)
# LLM_OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_OPENAI_API_KEY=
