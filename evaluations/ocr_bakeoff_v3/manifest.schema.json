{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ocr-bakeoff-v3-manifest.schema.json",
  "type": "object",
  "required": ["version", "frozen", "samples"],
  "properties": {
    "version": {"type": "string", "const": "ocr-bakeoff-v3.1"},
    "frozen": {"type": "boolean"},
    "path_policy": {"type": "string"},
    "samples": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "category", "path_env", "ground_truth"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "category": {"enum": ["english_two_column", "tables_and_math", "japanese_horizontal", "japanese_vertical", "notes_and_bibliography", "embedded_text", "scanned", "no_outline"]},
          "path_env": {"type": "string", "pattern": "^OCR_BAKEOFF_[A-Z0-9_]+_PDF$"},
          "ground_truth": {"type": "string", "pattern": "^annotations/[a-z0-9_]+\\.json$"},
          "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
          "pair": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
