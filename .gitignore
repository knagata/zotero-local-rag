# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
src/*.egg-info/

# ── uv ──────────────────────────────────────────────────
uv.lock

# ── 環境設定 ─────────────────────────────────────────────
.env
.env.policy

# ── macOS ────────────────────────────────────────────────
.DS_Store

# ── 一時ファイル ─────────────────────────────────────────
tmp/
*.pid

# ── Claude Code ──────────────────────────────────────────
/.claude

# ── ローカルデータ面 ──────────────────────────────────────
# DB、manifest、モデル、キャッシュ、監査結果、バックアップを含め、
# data/ はすべて再生成可能なランタイム状態。Git追跡対象を置かない。
/data/

# ── ローカル評価・監査生成物 ──────────────────────────────
# 個人のZoteroキー、所蔵資料名、絶対パスを含み得るため追跡しない。
/evaluations/legacy_retirement_baseline_*.json
/evaluations/source_verification_*.json
/evaluations/v3_cutover/
/evaluations/v3_cutover_audit*.json
/evaluations/outline_gold_v1/
/evaluations/ocr_bakeoff_v3/sample_suggestions.json
/evaluations/ocr_bakeoff_v3/selected_samples.json

# ── 設計メモ ─────────────────────────────────────────────
LAYOUT_DESIGN_NOTES.md
dev-notes/

# ── ログ全般 ─────────────────────────────────────────────
*.log

# ── Ralph Loop 作業ファイル ──────────────────────────────
prd.json
progress.txt

# ── バックアップ ──────────────────────────────────────────
data.backup.*/

# .env のバックアップ（APIキーを含む）。.env 自体は12行目で無視しているが、
# 手動バックアップは別名になるので拾えていなかった。
.env.bak*
.env.*.bak
.env.backup*
